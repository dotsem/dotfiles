  "enabledPlugins": {
    "ponytail@ponytail": true,
    "superpowers@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
