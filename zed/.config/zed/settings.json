// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "plan",
        "model": "haiku"
      },
      "type": "registry"
    }
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "play_sound_when_agent_done": "when_hidden",
    "notify_when_agent_waiting": "primary_screen",
    "default_profile": "ask",
    "default_model": {
      "effort": "high",
      "provider": "anthropic",
      "model": "claude-opus-4-7",
      "enable_thinking": true
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "right"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "buffer_font_family": "FiraCode Nerd Font",
  "file_types": {
    "cpp": [
      "*.cpp"
    ],
    "plaintext": [
      ".todo"
    ]
  },
  "linked_edits": true,
  "show_whitespaces": "none",
  "indent_guides": {
    "enabled": false
  },
  "soft_wrap": "none",
  "outline_panel": {
    "dock": "right"
  },
  "project_panel": {
    "dock": "right"
  },
  "terminal": {
    "font_family": "MesloLGS NF",
    "dock": "right"
  },
  "minimap": {
    "show": "always"
  },
  "telemetry": {
    "metrics": false,
    "diagnostics": false
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme"
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark Pro"
  }
}
